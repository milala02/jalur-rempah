{
  "name": "jalur-rempah-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @jalur-rempah/api db:migrate",
    "db:seed": "pnpm --filter @jalur-rempah/api db:seed",
    "sim:run": "pnpm --filter @jalur-rempah/worker sim:run",
    "sim:short": "pnpm --filter @jalur-rempah/worker sim:run -- --ticks 2000 --bots 10 --seed 11,29"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vitest": "^2.1.2"
  }
}
