# Konfigurasi Lingkungan Jalur Rempah (Backend API & Worker)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jalur_rempah
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
ADMIN_API_KEY=jr-admin-secret-key

# Fase 9: OAuth 2.0 Client ID dari Google Cloud Console untuk fitur "Masuk dengan Google" (POST /v1/auth/google)
GOOGLE_CLIENT_ID=
